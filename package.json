{
  "name": "icloudpd-node",
  "version": "0.1.0",
  "description": "Node.js port of icloud_photos_downloader (MIT). iCloud photo downloader and SDK.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "icloudpd-node": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "docs/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test test/",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "icloud",
    "photos",
    "downloader",
    "live-photos",
    "sdk",
    "apple"
  ],
  "author": "Chen Xing",
  "license": "MIT",
  "homepage": "https://github.com/chenxing/icloudpd-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenxing/icloudpd-node.git"
  },
  "bugs": {
    "url": "https://github.com/chenxing/icloudpd-node/issues"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/srp": "^0.0.33",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "piexifjs": "^1.0.6",
    "undici": "^8.11.2"
  }
}
